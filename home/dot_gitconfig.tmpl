[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[user]
	name = {{ .name }}
	email = {{ .email }}
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[rerere]
	enabled = true
[core]
	excludesFile = ~/.config/git/ignore
[url "git@github.com:"]
	insteadOf = https://github.com/
{{ if stat (joinPath .chezmoi.homeDir ".local/bin/origin") -}}
[credential "https://origin.cursor.com/git"]
	helper = 
	helper = !{{ .chezmoi.homeDir }}/.local/bin/origin credential-helper
[credential "https://origin.cursor.com"]
	helper = 
	helper = !{{ .chezmoi.homeDir }}/.local/bin/origin credential-helper
{{ end -}}
{{ if stat (joinPath .chezmoi.homeDir ".ssh/id_ed25519.pub") -}}
[gpg]
	format = ssh
[user]
	signingkey = ~/.ssh/id_ed25519.pub
[commit]
	gpgsign = true
[tag]
	gpgsign = true
{{ end -}}
