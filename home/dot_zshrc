HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt share_history hist_ignore_all_dups auto_cd

autoload -Uz compinit && compinit
zmodload zsh/complist
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' menu select

_spaceship="${HOMEBREW_PREFIX:-/opt/homebrew}/opt/spaceship/spaceship.zsh"
[ -f "$_spaceship" ] && source "$_spaceship"
unset _spaceship

for file in ~/.dotfiles/config/{path,aliases,functions}; do
    [ -r "$file" ] && [ -f "$file" ] && source "$file";
done;
unset file;

[ -f "$HOME/.zshrc.private" ] && source "$HOME/.zshrc.private"

[ -f /opt/homebrew/opt/asdf/libexec/asdf.sh ] && . /opt/homebrew/opt/asdf/libexec/asdf.sh

export PATH="$HOME/.local/bin:$PATH"

# Shell enhancements — each one is skipped when the brew formula isn't installed
_autosuggest="${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
[ -f "$_autosuggest" ] && source "$_autosuggest"
unset _autosuggest

if command -v fzf >/dev/null 2>&1; then
    source <(fzf --zsh)
    export FZF_DEFAULT_OPTS="--height 40% --layout reverse --border rounded"
    if command -v fd >/dev/null 2>&1; then
        export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git"
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git"
    fi
    command -v bat >/dev/null 2>&1 && \
        export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
    command -v eza >/dev/null 2>&1 && \
        export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always {}'"
fi

command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# Must stay last: it wraps every widget defined above it
_highlight="${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
[ -f "$_highlight" ] && source "$_highlight"
unset _highlight
