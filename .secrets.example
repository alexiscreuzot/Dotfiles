# Secrets Template
# Copy this file to ~/.secrets and add your actual tokens/keys
# NEVER commit the actual .secrets file to version control!
#
# Usage: Source this in your path file:
# [ -f ~/.secrets ] && source ~/.secrets

# Homebrew GitHub API Token (for private taps and avoiding rate limits)
# Get one at: https://github.com/settings/tokens
# export HOMEBREW_GITHUB_API_TOKEN="your_token_here"

# AWS Credentials (if needed)
# export AWS_ACCESS_KEY_ID="your_key_here"
# export AWS_SECRET_ACCESS_KEY="your_secret_here"

# Other API keys
# export OPENAI_API_KEY="your_key_here"
# export ANTHROPIC_API_KEY="your_key_here"

