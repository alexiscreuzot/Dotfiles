#   ------------------------------------------------------------

# Fixes Insecure completion-dependent directories detected
ZSH_DISABLE_COMPFIX=true

# Path to your oh-my-zsh installation.
export ZSH="/Users/alex/.oh-my-zsh"
ZSH_THEME="spaceship"
plugins=(git)
source $ZSH/oh-my-zsh.sh

# export BASH_SILENCE_DEPRECATION_WARNING=1

# lang variables
export LC_ALL="en_US.UTF-8"
export LANG="en_US.UTF-8"
export LANGUAGE="en_US.UTF-8"

# Load secrets from ~/.secrets if it exists (API tokens, keys, etc.)
[ -f ~/.secrets ] && source ~/.secrets

# SSH - Uncomment to auto-load SSH keys on shell startup
# ssh-add --apple-load-keychain --apple-use-keychain ~/.ssh/id_rsa 2>/dev/null


# NVM - Lazy Loading (speeds up shell startup significantly)
export NVM_DIR="$HOME/.nvm"
# Lazy load NVM - only load when node/npm/nvm commands are used
nvm() {
    unset -f nvm node npm npx
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
    nvm "$@"
}
node() {
    unset -f nvm node npm npx
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
    node "$@"
}
npm() {
    unset -f nvm node npm npx
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
    npm "$@"
}
npx() {
    unset -f nvm node npm npx
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
    npx "$@"
}

# RBENV - Lazy Loading
export PATH=$HOME/.rbenv/bin:/usr/local/bin:$HOME/.bin:$PATH
rbenv() {
    unset -f rbenv
    eval "$(command rbenv init - zsh)"
    rbenv "$@"
}

# Homebrew (should be after rbenv so that path takes priority over Intel)
# SECURITY: Store tokens in ~/.secrets or environment variables, not in dotfiles!
# Uncomment and add to a private file: export HOMEBREW_GITHUB_API_TOKEN=your_token_here
export PATH="/opt/homebrew/bin:$PATH"

# PYENV - Lazy Loading
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
pyenv() {
    unset -f pyenv
    eval "$(command pyenv init -)"
    pyenv "$@"
}

# Android
export ANDROID_SDK=$HOME/Library/Android/sdk
export PATH=$HOME/Library/Android/sdk/platform-tools:$PATH

# Flutter
export PATH="$HOME/flutter/bin:$PATH"

# GCloud
if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi
if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi
