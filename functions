# Determine size of a file or total size of a directory
function size() {
    if du -b /dev/null > /dev/null 2>&1; then
        local arg=-sbh;
    else
        local arg=-sh;
    fi
    if [[ -n "$@" ]]; then
        du $arg -- "$@";
    else
        du $arg .[^.]* ./*;
    fi;
}

gpgencrypt() {
    # Function to read multi-line input until a specific end signal (Ctrl-D)
    read_multiline_input() {
        echo "Enter the content (press Ctrl-D when finished):"
        local content=""
        while IFS= read -r line; do
            content+="$line\n"
        done
        echo "$content"
    }

    # Read the message
    echo "Let's encrypt a message with PGP!"
    echo "Enter the message to encrypt (press Ctrl-D when finished):"
    local message=$(read_multiline_input)

    # Temporary file for the public key
    local TEMP_KEY_FILE=$(mktemp)

    # Read the recipient's public key
    echo "Paste the recipient's public key (press Ctrl-D when finished):"
    local key_content=$(read_multiline_input)
    echo -e "$key_content" > "$TEMP_KEY_FILE"

    # Import the public key and extract the email address
    local import_output=$(gpg --import "$TEMP_KEY_FILE" 2>&1)
    local recipient_email=$(echo "$import_output" | sed -n 's/.*"\(.*\)" not changed/\1/p')

    # Check the extracted email address
    echo "Extracted email address: $recipient_email"

    # Encrypt the message and display the encrypted message
    echo -e "$message" | gpg --encrypt --recipient "$recipient_email" --armor

    # Clean up: Remove the temporary file
    rm "$TEMP_KEY_FILE"
}

gpgdecrypt() {
    # Function to read multi-line input until a specific end signal (Ctrl-D)
    read_multiline_input() {
        echo "Enter the encrypted message (press Ctrl-D when finished):"
        local content=""
        while IFS= read -r line; do
            content+="$line\n"
        done
        echo "$content"
    }

    echo "Let's decrypt a message with PGP!"
    echo "Enter the message to decrypt (press Ctrl-D when finished):"

    # Read the encrypted message
    local encrypted_message=$(read_multiline_input)

    # Decrypt the message and display the output
    echo -e "$encrypted_message" | gpg --decrypt --pinentry-mode loopback 2>&1 
}


