# GitHub PR Auto-Approver using GitHub CLI
# Requires: gh CLI tool installed and authenticated
#!/bin/zsh
# GitHub PR Auto-Approver using GitHub CLI (zsh compatible)
# Add this to your ~/.zshrc

approve_pr() {
    if [ $# -eq 0 ]; then
        echo "Usage: approve_pr <pr_url> [review_message]"
        echo "Example: approve_pr https://github.com/sorenson-eng/forum-backend-socket/pull/132"
        return 1
    fi
    
    local pr_url="$1"
    local review_message="${2:-Approved}"
    
    # Check if gh CLI is installed
    if ! command -v gh &> /dev/null; then
        echo "❌ Error: GitHub CLI (gh) is not installed"
        echo "Install it with: brew install gh"
        return 1
    fi
    
    # Check if authenticated
    if ! gh auth status &> /dev/null; then
        echo "❌ Error: Not authenticated with GitHub CLI"
        echo "Run: gh auth login"
        return 1
    fi
    
    # Extract components using zsh parameter expansion
    # Remove the https://github.com/ prefix
    local url_without_prefix="${pr_url#https://github.com/}"
    
    # Split on '/' - zsh uses different syntax
    local parts=(${(s:/:)url_without_prefix})
    
    if [[ ${#parts} -ge 4 && "${parts[3]}" == "pull" ]]; then
        local owner="${parts[1]}"
        local repo="${parts[2]}"
        local pr_number="${parts[4]}"
    else
        echo "❌ Error: Invalid GitHub PR URL format"
        echo "Expected format: https://github.com/owner/repo/pull/123"
        echo "Received: $pr_url"
        return 1
    fi
    
    echo "🔍 Approving PR: $owner/$repo#$pr_number"
    
    # Approve the PR using gh CLI
    if gh pr review "$pr_number" --repo "$owner/$repo" --approve --body "$review_message"; then
        echo "✅ Successfully approved PR #$pr_number"
        echo "🔗 View PR: $pr_url"
    else
        echo "❌ Failed to approve PR #$pr_number"
        return 1
    fi
}

# Short alias
alias apr='approve_pr'

function iconify() {
    ITUNES_ARTWORK="$1"
    FOLDER="${2:-.}"

    mkdir -p "$FOLDER"

    sizes=(29 40 60 76)

    for i in ${sizes[@]}; do
        s1x=${i}
        s2x=$(expr ${i} \* 2)
        s3x=$(expr ${i} \* 3)
        sips -z ${s1x} ${s1x} "$ITUNES_ARTWORK" --out "${FOLDER}/Icon-${i}.png"
        sips -z ${s2x} ${s2x} "$ITUNES_ARTWORK" --out "${FOLDER}/Icon-${i}@2x.png"
        sips -z ${s3x} ${s3x} "$ITUNES_ARTWORK" --out "${FOLDER}/Icon-${i}@3x.png"
    done

    sips -z 167 167 "$ITUNES_ARTWORK" --out "${FOLDER}/Icon-83.5@2x.png"
}

# Determine size of a file or total size of a directory
function size() {
    if du -b /dev/null > /dev/null 2>&1; then
        local arg=-sbh;
    else
        local arg=-sh;
    fi
    if [[ -n "$@" ]]; then
        du $arg -- "$@";
    else
        du $arg .[^.]* ./*;
    fi;
}

# `o` with no arguments opens the current directory, otherwise opens the given
# location
function o() {
    if [ $# -eq 0 ]; then
        open .;
    else
        open "$@";
    fi;
}


# Function to delete a Git tag both locally and remotely
delete_git_tag() {
    if [ -z "$1" ]; then
        echo "Usage: delete_git_tag <tagname>"
        return 1
    fi

    TAG=$1

    # Delete the tag locally
    echo "Deleting local tag: $TAG"
    git tag -d $TAG

    # Delete the tag from the remote
    echo "Deleting remote tag: $TAG"
    git push origin :refs/tags/$TAG

    echo "Tag $TAG deleted locally and from the remote."
}

# Function to delete a Git tag locally and remotely, then recreate it on the latest commit
retag() {
    if [ -z "$1" ]; then
        echo "Usage: retag <tagname>"
        return 1
    fi

    TAG=$1

    echo "Deleting local tag: $TAG"
    git tag -d "$TAG"

    echo "Deleting remote tag: $TAG"
    git push origin :refs/tags/"$TAG"

    echo "Creating new tag: $TAG on latest commit"
    git tag "$TAG"

    echo "Pushing new tag to remote"
    git push origin "$TAG"

    echo "Tag $TAG was retagged to the latest commit."
}
